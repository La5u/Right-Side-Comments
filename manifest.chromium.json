{
  "manifest_version": 3,
  "name": "Right Side Comments",
  "version": "2.6",
  "description": "Toggle YouTube comments on the right side instead of recommendations.",
  "homepage_url": "https://github.com/La5u/Right-Side-Comments",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "Right Side Comments",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icon.png",
      "48": "icon.png",
      "96": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "32": "icon.png",
    "48": "icon.png",
    "96": "icon.png",
    "128": "icon.png"
  },
  "commands": {
    "toggle-comments-sidebar": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y",
        "linux": "Ctrl+Shift+U"
      },
      "description": "Toggle sidebar"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_start"
    }
  ]
}
