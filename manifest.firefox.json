{
  "manifest_version": 3,
  "name": "Right Side Comments",
  "version": "2.8.1",
  "description": "Toggle YouTube comments on the right side instead of recommendations.",
  "homepage_url": "https://la5u.github.io/Right-Side-Comments/",
  "permissions": ["storage"],
  "background": {
    "scripts": ["background.js"]
  },

  "action": {
    "default_title": "Right Side Comments",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "commands": {
    "toggle-comments-sidebar": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y",
        "linux": "Ctrl+Shift+U"
      },
      "description": "Toggle sidebar"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-comments-sidebar@example.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
